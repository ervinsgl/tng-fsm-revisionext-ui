<mvc:View
    controllerName="com.tng.fsm.revisionext.app.controller.RevisionExt"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page
        id="page"
        showNavButton="false"
        showHeader="true"
        busy="{view>/busy}"
        busyIndicatorDelay="0">

        <customHeader>
            <OverflowToolbar design="Info">
                <core:Icon src="sap-icon://connected" class="sapUiTinyMarginEnd" />
                <Title text="FSM Revision Extension" level="H4" />
                <ToolbarSpacer />
                <ObjectStatus
                    text="{= ${view>/context/source} === 'mobile' ? 'Mobile App' : 'Web UI' }"
                    state="Success"
                    visible="{view>/contextLoaded}" />
                <ObjectStatus
                    text="{view>/context/objectType}"
                    state="Information"
                    visible="{view>/contextLoaded}" />
            </OverflowToolbar>
        </customHeader>

        <content>

            <!-- Not opened from FSM -->
            <IllustratedMessage
                visible="{view>/showError}"
                illustrationType="sapIllus-NoMail"
                title="Open from FSM"
                description="Open this app from FSM Mobile (Web Container) or FSM Web UI (Shell Extension)." />

            <!-- Context loaded -->
            <layout:VerticalLayout
                visible="{view>/contextLoaded}"
                width="100%"
                class="sapUiContentPadding">

                <Panel
                    headerText="Session Context"
                    expandable="true"
                    expanded="false"
                    class="sapUiResponsiveMargin"
                    width="auto">

                    <List
                        id="contextList"
                        mode="None"
                        showSeparators="Inner">

                        <ObjectListItem
                            title="{view>/context/userName}"
                            intro="User"
                            icon="sap-icon://account" />

                        <ObjectListItem
                            title="{view>/context/companyName}"
                            intro="Company"
                            icon="sap-icon://factory" />

                        <ObjectListItem
                            title="{view>/context/cloudAccount}"
                            intro="Cloud Account"
                            icon="sap-icon://cloud" />

                        <ObjectListItem
                            title="{view>/context/cloudId}"
                            intro="Cloud ID / Object ID"
                            icon="sap-icon://key-user-settings" />

                        <ObjectListItem
                            title="{view>/context/objectType}"
                            intro="Object Type"
                            icon="sap-icon://activity-2" />

                        <ObjectListItem
                            title="{view>/context/language}"
                            intro="Language"
                            icon="sap-icon://globe" />

                        <ObjectListItem
                            title="{view>/context/dataCloudFullQualifiedDomainName}"
                            intro="FSM Cloud Domain"
                            icon="sap-icon://world" />

                    </List>

                </Panel>

                <!-- One small table per original-activity smartform (root).
                     Rows = activity lineage; each row carries the smartform
                     that chains (via Z_PreviousChecklist) to this root and
                     belongs to that activity. -->
                <VBox
                    id="tablesContainer"
                    busy="{view>/revisionsBusy}"
                    busyIndicatorDelay="0"
                    items="{view>/tables}"
                    class="sapUiSmallMarginTop">

                    <Table
                        items="{view>rows}"
                        class="sapUiResponsiveMargin"
                        width="auto">

                        <headerToolbar>
                            <Toolbar>
                                <Title text="{view>smartformDescription}" level="H5" />
                                <ToolbarSpacer />
                                <Button
                                    text="Create Revision"
                                    type="Emphasized"
                                    icon="sap-icon://add-document"
                                    press=".onCreateRevision" />
                            </Toolbar>
                        </headerToolbar>

                        <columns>
                            <Column width="7rem"><header><Text text="Revision" /></header></Column>
                            <Column width="6rem"><header><Text text="Code" /></header></Column>
                            <Column><header><Text text="Activity ID" /></header></Column>
                            <Column><header><Text text="Subject" /></header></Column>
                            <Column><header><Text text="Smartform Description" /></header></Column>
                            <Column><header><Text text="Smartform Name" /></header></Column>
                            <Column><header><Text text="Attachment Description" /></header></Column>
                            <Column><header><Text text="Attachment Name" /></header></Column>
                            <Column><header><Text text="Revision/Report Name" /></header></Column>
                        </columns>

                        <items>
                            <ColumnListItem
                                highlight="{= ${view>isOriginal} ? 'Information' : 'None' }">
                                <cells>
                                    <ObjectStatus
                                        text="{view>revisionLabel}"
                                        state="{= ${view>isOriginal} ? 'Information' : 'None' }"
                                        inverted="{view>isOriginal}" />
                                    <Text text="{view>code}" />
                                    <Text text="{view>id}" />
                                    <Text text="{view>subject}" />
                                    <Text text="{view>smartformDescription}" />
                                    <Text text="{view>smartformName}" />
                                    <Text text="{view>attachmentDescription}" />
                                    <Text text="{view>attachmentName}" />
                                    <Text text="{view>revisionName}" />
                                </cells>
                            </ColumnListItem>
                        </items>

                    </Table>

                </VBox>

                <!-- No smartforms: show activity lineage only + message -->
                <VBox
                    visible="{view>/noSmartforms}"
                    class="sapUiResponsiveMargin">

                    <MessageStrip
                        text="No smartforms created for the original activity."
                        type="Information"
                        showIcon="true"
                        class="sapUiSmallMarginBottom" />

                    <Table
                        items="{view>/activities}"
                        width="auto">
                        <columns>
                            <Column width="7rem"><header><Text text="Revision" /></header></Column>
                            <Column width="6rem"><header><Text text="Code" /></header></Column>
                            <Column><header><Text text="Activity ID" /></header></Column>
                            <Column><header><Text text="Subject" /></header></Column>
                        </columns>
                        <items>
                            <ColumnListItem
                                highlight="{= ${view>isOriginal} ? 'Information' : 'None' }">
                                <cells>
                                    <ObjectStatus
                                        text="{view>revisionLabel}"
                                        state="{= ${view>isOriginal} ? 'Information' : 'None' }"
                                        inverted="{view>isOriginal}" />
                                    <Text text="{view>code}" />
                                    <Text text="{view>id}" />
                                    <Text text="{view>subject}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>

                </VBox>

            </layout:VerticalLayout>

        </content>

    </Page>
</mvc:View>