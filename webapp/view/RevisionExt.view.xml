<mvc:View
    controllerName="com.tns.fsm.revisionext.app.controller.RevisionExt"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page
        id="page"
        showNavButton="false"
        showHeader="true"
        busy="{view>/busy}"
        busyIndicatorDelay="0">

        <customHeader>
            <OverflowToolbar design="Info">
                <core:Icon src="sap-icon://connected" class="sapUiTinyMarginEnd" />
                <Title text="{i18n>headerTitle}" level="H4" />
                <ToolbarSpacer />
                <ObjectStatus
                    text="{= ${view>/context/source} === 'mobile' ? ${i18n>sourceMobile} : ${i18n>sourceWebUi} }"
                    state="Success"
                    visible="{view>/contextLoaded}" />
                <ObjectStatus
                    text="{view>/context/objectType}"
                    state="Information"
                    visible="{view>/contextLoaded}" />
            </OverflowToolbar>
        </customHeader>

        <content>

            <!-- Not opened from FSM -->
            <IllustratedMessage
                visible="{view>/showError}"
                illustrationType="sapIllus-NoMail"
                title="{i18n>errorTitle}"
                description="{i18n>errorDescription}" />

            <!-- Context loaded -->
            <layout:VerticalLayout
                visible="{view>/contextLoaded}"
                width="100%"
                class="sapUiContentPadding">

                <!-- Toolbar: filter tables by description + expand/collapse all -->
                <Toolbar class="sapUiSmallMarginTop">
                    <SearchField
                        width="20rem"
                        placeholder="{i18n>searchPlaceholder}"
                        liveChange=".onSearchTables"
                        search=".onSearchTables" />
                    <ToolbarSpacer />
                    <Button
                        text="{= ${view>/allExpanded} ? ${i18n>collapseAll} : ${i18n>expandAll} }"
                        icon="{= ${view>/allExpanded} ? 'sap-icon://collapse-all' : 'sap-icon://expand-all' }"
                        press=".onToggleExpandAll" />
                </Toolbar>

                <!-- One small table per original-activity smartform (root).
                     Rows = activity lineage; each row carries the smartform
                     that chains (via Z_PreviousChecklist) to this root and
                     belongs to that activity. -->
                <VBox
                    id="tablesContainer"
                    busy="{view>/revisionsBusy}"
                    busyIndicatorDelay="0"
                    items="{view>/tables}"
                    class="sapUiSmallMarginTop">

                    <Panel
                        expandable="true"
                        expanded="{view>expanded}"
                        visible="{view>visible}"
                        class="sapUiResponsiveMargin"
                        width="auto">

                        <headerToolbar>
                            <Toolbar>
                                <Title text="{view>smartformDescription}" level="H5" />
                                <ToolbarSpacer />
                                <Button
                                    text="{i18n>createRevision}"
                                    type="Emphasized"
                                    icon="sap-icon://add-document"
                                    press=".onCreateRevision" />
                            </Toolbar>
                        </headerToolbar>

                        <content>
                            <Table
                                items="{view>rows}"
                                width="auto">

                                <columns>
                                    <Column width="7rem"><header><Text text="{i18n>colRevision}" /></header></Column>
                                    <Column width="6rem"><header><Text text="{i18n>colCode}" /></header></Column>
                                    <Column><header><Text text="{i18n>colSmartformDescription}" /></header></Column>
                                    <Column><header><Text text="{i18n>colSmartformName}" /></header></Column>
                                    <Column><header><Text text="{i18n>colAttachmentName}" /></header></Column>
                                    <Column width="6rem"><header><Text text="{i18n>colStatus}" /></header></Column>
                                </columns>

                                <items>
                                    <ColumnListItem
                                        highlight="{= ${view>isOriginal} ? 'Information' : 'None' }">
                                        <cells>
                                            <ObjectStatus
                                                text="{
                                                    parts: ['view>isOriginal', 'view>revisionNumber', 'i18n>revisionOriginal', 'i18n>revisionLabel', 'i18n>revisionLabelUnknown'],
                                                    formatter: '.formatRevisionLabel'
                                                }"
                                                state="{= ${view>isOriginal} ? 'Information' : 'None' }"
                                                inverted="{view>isOriginal}" />
                                            <Text text="{view>code}" />
                                            <Text text="{view>smartformDescription}" />
                                            <Text text="{view>smartformName}" />
                                            <Text text="{view>attachmentName}" />
                                            <ObjectStatus
                                                text="{
                                                    parts: ['view>hasSmartform', 'view>closed', 'i18n>statusClosed', 'i18n>statusOpen'],
                                                    formatter: '.formatStatusText'
                                                }"
                                                state="{= !${view>hasSmartform} ? 'None' : (${view>closed} ? 'Success' : 'Error') }" />
                                        </cells>
                                    </ColumnListItem>
                                </items>

                            </Table>
                        </content>

                    </Panel>

                </VBox>

                <!-- No smartforms: show activity lineage only + message -->
                <VBox
                    visible="{view>/noSmartforms}"
                    class="sapUiResponsiveMargin">

                    <MessageStrip
                        text="{i18n>noSmartformsMessage}"
                        type="Information"
                        showIcon="true"
                        class="sapUiSmallMarginBottom" />

                    <Table
                        items="{view>/activities}"
                        width="auto">
                        <columns>
                            <Column width="7rem"><header><Text text="{i18n>colRevision}" /></header></Column>
                            <Column width="6rem"><header><Text text="{i18n>colCode}" /></header></Column>
                            <Column><header><Text text="{i18n>colSubject}" /></header></Column>
                        </columns>
                        <items>
                            <ColumnListItem
                                highlight="{= ${view>isOriginal} ? 'Information' : 'None' }">
                                <cells>
                                    <ObjectStatus
                                        text="{
                                            parts: ['view>isOriginal', 'view>revisionNumber', 'i18n>revisionOriginal', 'i18n>revisionLabel', 'i18n>revisionLabelUnknown'],
                                            formatter: '.formatRevisionLabel'
                                        }"
                                        state="{= ${view>isOriginal} ? 'Information' : 'None' }"
                                        inverted="{view>isOriginal}" />
                                    <Text text="{view>code}" />
                                    <Text text="{view>subject}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>

                </VBox>

            </layout:VerticalLayout>

        </content>

    </Page>
</mvc:View>